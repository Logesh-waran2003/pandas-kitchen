generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  logoUrl         String?
  themeColor      String           @default("#f97316")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branches        Branch[]
  users           User[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  tables          Table[]
  orders          Order[]
  customers       Customer[]
  departments     Department[]
  payments        Payment[]
  menuAddonGroups MenuAddonGroup[]
  inventoryItems  InventoryItem[]
  shifts          Shift[]
  reservations    Reservation[]
  coupons              Coupon[]
  onlineSettings       RestaurantOnlineSettings?
  loyaltyTransactions  LoyaltyTransaction[]
}

model Branch {
  id             String          @id @default(cuid())
  restaurantId   String
  name           String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id])
  users          User[]
  tables         Table[]
  orders         Order[]
  departments    Department[]
  kotTickets     KOTTicket[]
  inventoryItems InventoryItem[]
  shifts         Shift[]
  reservations   Reservation[]
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole    @default(CAPTAIN)
  restaurantId  String?
  branchId      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])
  branch        Branch?     @relation(fields: [branchId], references: [id])
  sessions      Session[]
  shiftsOpened  Shift[]     @relation("ShiftOpenedBy")
  shiftsClosed  Shift[]     @relation("ShiftClosedBy")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  BRANCH_MANAGER
  CASHIER
  CAPTAIN
  KITCHEN_STAFF
  CUSTOMER
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  imageUrl     String?
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id              String               @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?
  price           Decimal              @db.Decimal(10, 2)
  imageUrl        String?
  isAvailable     Boolean              @default(true)
  isVeg           Boolean              @default(false)
  allergens       String[]
  preparationTime Int?
  sortOrder       Int                  @default(0)
  departmentId    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id])
  category        MenuCategory         @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  variants        MenuItemVariant[]
  addonGroups     MenuItemAddonGroup[]
  ingredients     MenuItemIngredient[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId])
}

model MenuItemVariant {
  id          String      @id @default(cuid())
  menuItemId  String
  name        String
  price       Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
}

model MenuAddonGroup {
  id           String               @id @default(cuid())
  restaurantId String
  name         String
  minSelect    Int                  @default(0)
  maxSelect    Int                  @default(1)
  isRequired   Boolean              @default(false)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  addons       MenuAddon[]
  menuItems    MenuItemAddonGroup[]
}

model MenuAddon {
  id              String           @id @default(cuid())
  addonGroupId    String
  name            String
  price           Decimal          @db.Decimal(10, 2) @default(0)
  isAvailable     Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  addonGroup      MenuAddonGroup   @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  orderItemAddons OrderItemAddon[]
}

model MenuItemAddonGroup {
  menuItemId   String
  addonGroupId String
  menuItem     MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addonGroup   MenuAddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, addonGroupId])
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  branchId     String
  tableNumber  String
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  qrCode       String?
  isActive     Boolean     @default(true)
  // floor plan layout fields
  posX         Int         @default(50)
  posY         Int         @default(50)
  width        Int         @default(80)
  height       Int         @default(80)
  shape        String      @default("rectangle")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  branch       Branch      @relation(fields: [branchId], references: [id])
  orders       Order[]
  reservations Reservation[]
}

model Customer {
  id            String            @id @default(cuid())
  restaurantId  String
  name          String
  phone         String
  email         String?
  address       String?
  passwordHash  String?
  loyaltyPoints Int               @default(0)
  totalOrders   Int               @default(0)
  totalSpent    Decimal           @db.Decimal(10, 2) @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id])
  orders              Order[]
  addresses           CustomerAddress[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}



model Order {
  id            String      @id @default(cuid())
  restaurantId  String
  branchId      String
  tableId       String?
  customerId    String?
  orderNumber   String      @unique
  status        OrderStatus @default(PENDING)
  orderType     OrderType   @default(DINE_IN)
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  tax           Decimal     @default(0) @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  discountType  String?
  serviceCharge Decimal     @default(0) @db.Decimal(10, 2)
  gstRate       Decimal     @default(5) @db.Decimal(5, 2)
  gstAmount     Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @default(0) @db.Decimal(10, 2)
  paxCount        Int         @default(1)
  paymentStatus   String      @default("UNPAID")
  notes           String?
  rating          Int?
  deliveryAddress String?
  createdById     String?
  pickupCode      String?
  scheduledFor    DateTime?
  deliveryFee     Decimal     @default(0) @db.Decimal(10, 2)
  packagingFee    Decimal     @default(0) @db.Decimal(10, 2)
  tip             Decimal     @default(0) @db.Decimal(10, 2)
  couponId             String?
  couponDiscount       Decimal     @default(0) @db.Decimal(10, 2)
  loyaltyPointsEarned  Int         @default(0)
  eta                  Int?        // estimated prep time in minutes, set on CONFIRMED
  orderSource     OrderSource @default(QR_TABLE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  branch        Branch      @relation(fields: [branchId], references: [id])
  table         Table?      @relation(fields: [tableId], references: [id])
  customer      Customer?   @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  kotTickets    KOTTicket[]
  coupon             CouponUsage?
  pushSubscriptions  PushSubscription[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([branchId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  orderId   String?
  createdAt DateTime @default(now())

  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id          String           @id @default(cuid())
  orderId     String
  menuItemId  String
  variantId   String?
  variantName String?
  quantity    Int              @default(1)
  unitPrice   Decimal          @db.Decimal(10, 2)
  totalPrice  Decimal          @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem         @relation(fields: [menuItemId], references: [id])
  variant     MenuItemVariant? @relation(fields: [variantId], references: [id])
  addons      OrderItemAddon[]
  kotItem     KOTItem?
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  addonId     String
  name        String
  price       Decimal   @db.Decimal(10, 2)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon       MenuAddon @relation(fields: [addonId], references: [id])
}

model Department {
  id           String     @id @default(cuid())
  restaurantId String
  branchId     String
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  branch       Branch     @relation(fields: [branchId], references: [id])
  kotItems     KOTItem[]
}

model KOTTicket {
  id           String    @id @default(cuid())
  orderId      String
  branchId     String
  ticketNumber String    @unique
  status       KOTStatus @default(PENDING)
  printedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  order        Order     @relation(fields: [orderId], references: [id])
  branch       Branch    @relation(fields: [branchId], references: [id])
  items        KOTItem[]

  @@index([branchId, status])
}

model KOTItem {
  id           String        @id @default(cuid())
  kotTicketId  String
  orderItemId  String        @unique
  departmentId String?
  status       KOTItemStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kotTicket    KOTTicket     @relation(fields: [kotTicketId], references: [id], onDelete: Cascade)
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  restaurantId String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  reference    String?
  status       PaymentStatus @default(COMPLETED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])

  @@index([orderId])
  @@index([restaurantId])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KOTStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum KOTItemStatus {
  PENDING
  PREPARING
  DONE
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
  WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model InventoryItem {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String
  name         String
  unit         String
  currentStock Decimal  @default(0) @db.Decimal(10, 3)
  minStock     Decimal  @default(0) @db.Decimal(10, 3)
  costPerUnit  Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id])
  adjustments  StockAdjustment[]
  usedIn       MenuItemIngredient[]

  @@index([restaurantId, branchId])
  @@index([restaurantId, isActive])
}

model MenuItemIngredient {
  id              String        @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(10, 3)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([menuItemId])
}

model StockAdjustment {
  id              String              @id @default(cuid())
  inventoryItemId String
  type            StockAdjustmentType
  quantity        Decimal             @db.Decimal(10, 3)
  note            String?
  createdById     String?
  createdAt       DateTime            @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
}

enum StockAdjustmentType {
  RESTOCK
  MANUAL_DEDUCTION
  WASTE
  ORDER_DEDUCTION
}

model Shift {
  id            String      @id @default(cuid())
  restaurantId  String
  branchId      String
  openedById    String
  closedById    String?
  status        ShiftStatus @default(OPEN)
  openingFloat  Decimal     @default(0) @db.Decimal(10, 2)
  closingFloat  Decimal?    @db.Decimal(10, 2)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  branch        Branch      @relation(fields: [branchId], references: [id])
  openedBy      User        @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy      User?       @relation("ShiftClosedBy", fields: [closedById], references: [id])

  @@index([restaurantId, branchId])
  @@index([restaurantId, status])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  branchId     String
  tableId      String?
  customerName String
  phone        String
  partySize    Int
  date         DateTime
  notes        String?
  status       ReservationStatus @default(UPCOMING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id])
  table        Table?            @relation(fields: [tableId], references: [id])

  @@index([restaurantId, date])
  @@index([branchId, status])
}

enum ReservationStatus {
  UPCOMING
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DiscountType {
  PERCENT
  FLAT
}

enum OrderSource {
  POS
  QR_TABLE
  ONLINE
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  label        String   @default("Home")
  address      String
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Coupon {
  id             String        @id @default(cuid())
  restaurantId   String
  code           String
  discountType   DiscountType  @default(PERCENT)
  discountValue  Decimal       @db.Decimal(10, 2)
  minOrderValue  Decimal       @default(0) @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int           @default(0)
  expiresAt      DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id])
  usages         CouponUsage[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  customerId String?
  orderId    String   @unique
  usedAt     DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([couponId])
}

model RestaurantOnlineSettings {
  id                     String     @id @default(cuid())
  restaurantId           String     @unique
  onlineOrderingEnabled  Boolean    @default(true)
  deliveryEnabled        Boolean    @default(true)
  takeawayEnabled        Boolean    @default(true)
  deliveryRadiusKm       Float      @default(10)
  minOrderValue          Decimal    @default(0) @db.Decimal(10, 2)
  deliveryFee            Decimal    @default(0) @db.Decimal(10, 2)
  packagingFee           Decimal    @default(0) @db.Decimal(10, 2)
  serviceChargePercent   Decimal    @default(0) @db.Decimal(5, 2)
  estimatedPrepMins      Int        @default(20)
  pickupPrepMins         Int        @default(15)
  loyaltyPointsPerRupee  Float      @default(1)   // points earned per ₹1 spent
  loyaltyRedemptionRate  Float      @default(0.25) // ₹ value per 1 point
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id])
}

model LoyaltyTransaction {
  id           String   @id @default(cuid())
  customerId   String
  restaurantId String
  orderId      String?
  points       Int      // positive = earned, negative = redeemed
  type         String   // "EARNED" | "REDEEMED" | "ADJUSTED"
  description  String?
  createdAt    DateTime @default(now())

  customer     Customer   @relation(fields: [customerId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([customerId])
  @@index([restaurantId])
}
